# ============================================================
# Bloque para /etc/caddy/Caddyfile
#
# Publica el tablero en https://dnp-btcr.skaphe.com
#
# Sigue el mismo patrón que los bloques ya existentes (sbn-ecp, vault).
# Caddy obtiene y renueva el certificado TLS por su cuenta: el subdominio
# ya resuelve a la IP de este servidor (23.239.11.244).
#
# El 5080 es el puerto que docker-compose publica en loopback; el
# contenedor no está expuesto a la red por ningún otro medio.
#
# APLICADO el 2026-08-15. Se conserva como referencia de lo que hay en
# /etc/caddy/Caddyfile y para poder reconstruirlo si se rehace el host.
#
#     sudo tee -a /etc/caddy/Caddyfile < deploy/Caddyfile.snippet
#     sudo caddy validate --config /etc/caddy/Caddyfile
#     sudo systemctl reload caddy
# ============================================================

dnp-btcr.skaphe.com {
	reverse_proxy localhost:5080
}
