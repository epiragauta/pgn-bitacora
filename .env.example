# Plantilla de configuración para docker-compose.
# Copiar a .env y poner los valores reales. .env está en .gitignore:
# nunca se versiona una credencial.
#
#     cp .env.example .env
#
# ── Conexión cifrada (recomendado) ────────────────────────────────────
# La cadena de conexión NO viaja en claro. En appsettings.json vive el
# valor cifrado (SecureConfig:EncryptedConnection) y aquí solo el passphrase
# que lo descifra al arrancar. AES-256 con llave = SHA256(passphrase).
#
# Para generar el valor cifrado con tu contraseña real de BD:
#
#   dotnet run --project backend/src/PgnBitacora.Api -- \
#       --cifrar "Server=sqlserver,1433;Database=dnp_dpip;User Id=dnp_dpip_app;Password=LA_REAL;TrustServerCertificate=True" \
#       "EL_PASSPHRASE"
#
# Pega la salida en appsettings.json → SecureConfig:EncryptedConnection y
# define aquí el mismo passphrase:
SecureConfig__Passphrase=CAMBIAR

# ── Alternativa: cadena en claro ──────────────────────────────────────
# Si se define, tiene precedencia sobre la conexión cifrada. Útil para
# desarrollo local; no usar en despliegue.
# 'sqlserver' es el alias del contenedor de SQL Server dentro de la red
# sbn-ecp_umbraco-network; desde el host sería 127.0.0.1,1433.
# ConnectionStrings__DnpDpip=Server=sqlserver,1433;Database=dnp_dpip;User Id=dnp_dpip_app;Password=CAMBIAR;TrustServerCertificate=True

# Poner en false para ocultar /swagger en un despliegue público.
Swagger__Habilitado=true
